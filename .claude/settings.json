{
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm gen:codex)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git rebase:*)",
      "mcp__claude_ai_Figma__*",
      "mcp__figma__*",
      "mcp__figma-dev-mode-mcp-server__*",
      "Bash(curl -s https://api.marketgo.kro.kr/v3/api-docs*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore --staged:*)"
    ],
    "deny": [
      "WebFetch(domain:api.figma.com)",
      "WebFetch(domain:figma.com)",
      "WebFetch(domain:*.figma.com)",
      "Bash(curl *figma.com*)",
      "Bash(wget *figma.com*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "out=$(GIT_TERMINAL_PROMPT=0 git fetch origin dev 2>&1); if [ $? -ne 0 ]; then echo \"[세션 시작 dev 확인] ⚠️ fetch 실패 — 네트워크·인증 확인 필요: $(echo \"$out\" | tail -1)\"; elif git merge-base --is-ancestor origin/dev HEAD; then echo \"[세션 시작 dev 확인] 현재 브랜치가 최신 origin/dev를 포함함\"; else echo \"[세션 시작 dev 확인] ⚠️ 현재 브랜치가 최신 origin/dev를 포함하지 않음 — 작업 전 재정렬 필요\"; fi",
            "timeout": 45,
            "statusMessage": "origin/dev 기준선 확인 중"
          }
        ]
      }
    ]
  }
}
