# KAMIS OpenAPI 인증키/ID (https://www.kamis.or.kr) — 야채 시세 프로토타입 실호출용. 없으면 더미로 폴백.
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# Kakao REST 키 — 역지오코딩(동 판별)·장소 검색용. 서버 전용(BFF에서만 사용).
KAKAO_REST_KEY=

# Kakao JavaScript 앱키 — 가게 상세 지도 렌더링용(브라우저에서 SDK를 부른다).
# 도메인 제한이 걸리는 공개 키라 NEXT_PUBLIC_ 노출이 정상이다(시크릿 아님).
# 미설정 시 지도 캔버스 없이 주소·거리만 표시된다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# MarketGo Spring API base URL. 서버 전용이며 브라우저 번들에 노출하지 않는다.
# Swagger UI는 HTTP 서버 주소를 표시하지만 실제 연동은 HTTPS를 사용한다.
BACKEND_API_URL=https://api.marketgo.kro.kr
